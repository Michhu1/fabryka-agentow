# Skopiuj do .env i dostosuj. Wartości poniżej pasują do docker/docker-compose.yml.
NODE_ENV=development
PORT=5680
# PUBLIC_URL=http://localhost:5680
# WEBHOOK_URL=  (publiczny adres tunelu, gdy webhooki mają przychodzić z internetu)
EXECUTIONS_MODE=regular
PUBLIC_MODE=true
# Tylko do pracy lokalnej! W chmurze ustaw własny, losowy klucz (min. 32 znaki).
ENCRYPTION_KEY=dev-only-change-me-dev-only-change-me

DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5433
DB_POSTGRESDB_DATABASE=moj_n8n
DB_POSTGRESDB_USER=moj_n8n
DB_POSTGRESDB_PASSWORD=moj_n8n
DB_POSTGRESDB_SSL=false

REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=moj-n8n
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=moj-n8n <no-reply@localhost>
# Login i hasło do serwera SMTP — potrzebne w chmurze (Mailpit lokalnie ich nie wymaga).
# Gdy ustawisz login, połączenie musi być szyfrowane (TLS), inaczej mail nie wyjdzie.
# SMTP_USER=
# SMTP_PASSWORD=
# Adres edytora (linki w mailach; https:// włącza ciasteczko Secure). Domyślnie = PUBLIC_URL.
# W dev edytor działa na porcie 5681 (Vite).
EDITOR_BASE_URL=http://localhost:5681
# Folder ze zbudowanym edytorem (packages/editor/dist), który serwer ma sam udostępniać.
# Puste = serwer nie serwuje edytora (w dev robi to Vite). W obrazie Docker ustawione na /app/editor.
# EDITOR_DIST_PATH=
# Czy każdy może sam założyć konto (pierwsze konto = właściciel zawsze może)
SIGNUP_ENABLED=true
# Ile projektów zespołowych może prowadzić jeden użytkownik (jako administrator)
TEAM_PROJECTS_LIMIT=3
# Ile serwerów pośrednich (load balancer, proxy) stoi przed aplikacją — wtedy IP klienta bierzemy
# z nagłówka X-Forwarded-For. Lokalnie 0 (inaczej każdy mógłby podać fałszywe IP).
PROXY_HOPS=0
# Prometheus /metrics (domyślnie wyłączone)
METRICS_ENABLED=false
# Własny certyfikat CA bazy w chmurze (PEM), gdy DB_POSTGRESDB_SSL=true
# DB_POSTGRESDB_SSL_CA=
