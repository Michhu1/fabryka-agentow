{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
